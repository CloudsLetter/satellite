    "paths": {
        "/call_statistics": {
            "get": {
                "description": "Get the call statistics",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "call_statistics"
                ],
                "summary": "Get the call statistics",
                "parameters": [
                    {
                        "type": "string",
                        "description": "The destination of the call",
                        "name": "destination",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/respon.CallStatistics"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/motd": {
            "get": {
                "description": "Get the message of the day from a Minecraft server",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "motd"
                ],
                "summary": "Get the message of the day from a Minecraft server",
                "parameters": [
                    {
                        "type": "string",
                        "description": "The host of the Minecraft server",
                        "name": "host",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "The port of the Minecraft server",
                        "name": "port",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "The type of the Minecraft server",
                        "name": "type",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "boolean",
                        "description": "Whether to return the raw MOTD",
                        "name": "raw",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "boolean",
                        "description": "Whether to return the raw description",
                        "name": "desraw",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "boolean",
                        "description": "Whether to return anonymous players",
                        "name": "anonymous",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/respon.MotdResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
